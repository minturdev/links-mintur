---
import Header from "../components/Header.astro";
import Link from "../components/Link.astro";
import LinkImage from "../components/LinkImage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  {
    href: "https://www.instagram.com/minturformosa",
    title: "@minturformosa",
    icon: "instagram",
  },
  {
    href: "https://www.facebook.com/minturformosaoficial",
    title: "@minturformosaoficial",
    icon: "facebook",
  },
  {
    href: "https://www.tiktok.com/@formosahermosaoficial",
    title: "@formosahermosaoficial",
    icon: "tiktok",
  },
  {
    href: "https://wa.me/5493705155083",
    title: "(+54) 3705155083",
    icon: "whatsapp",
  },
  {
    href: "https://www.formosahermosa.gob.ar/",
    title: "www.formosahermosa.gob.ar",
    icon: "website",
  },
  {
    href: "mailto:socialmintur@formosa.gob.ar",
    title: "socialmintur@formosa.gob.ar",
    icon: "email",
  },
  {
    href: "https://www.formosahermosa.gob.ar/folleteria/",
    title: "Descargar Folletería",
    icon: "folleteria",
  },
]

import logoPomelo from "../assets/images/logo-pomelo.png";
---

<BaseLayout
  title="Ministerio de Turismo de Formosa"
  description="Sitio web de redes sociales y folletería del Ministerio de Turismo de Formosa"
>
  <div
    class="w-max h-min mx-auto p-4 pb-6 mt-16 z-0 bg-primary-light/30 backdrop-blur-[.5px] border-1 border-gray-200 rounded-lg shadow-2xs"
  >
    <Header />
    <section class="flex flex-col items-center gap-2">
      <!-- <LinkImage 
        href="https://www.instagram.com/s/aGlnaGxpZ2h0OjE4MjcxMDY4NDg3MjE2OTAz?story_media_id=3477264326836490368_4334092886"
        title="Fiesta Nacional del Pomelo XLI" 
        image={logoPomelo.src} /> -->
      {
        links.map((link) => (
          <Link
            href={link.href}
            title={link.title}
            icon={link.icon}
          />
        ))
      }
    </section>
  </div>
</BaseLayout>
